{
  "name": "fullstack-ai-operations-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,worker,sandbox,web \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:sandbox\" \"npm run dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx apps/api/src/server.ts",
    "dev:worker": "node --env-file-if-exists=.env --import tsx apps/api/src/worker-main.ts",
    "dev:sandbox": "node --env-file-if-exists=.env --import tsx apps/api/src/sandbox-main.ts",
    "dev:web": "node --env-file-if-exists=.env node_modules/next/dist/bin/next dev apps/web --hostname 0.0.0.0 --port 3000",
    "build": "npm run typecheck && npm run build --workspace apps/web",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace apps/web",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "test": "node --env-file-if-exists=.env.test node_modules/vitest/vitest.mjs run",
    "test:coverage": "node --env-file-if-exists=.env.test node_modules/vitest/vitest.mjs run --coverage",
    "test:e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "security:audit": "node scripts/dependency-audit.mjs",
    "verify": "npm run typecheck && npm run test:coverage && npm run build --workspace apps/web && npm run test:e2e && npm run security:secrets && npm run security:audit",
    "db:local": "node scripts/local-db.mjs",
    "setup:local": "node scripts/setup-local.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "6.19.3",
    "fastify": "5.12.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@electric-sql/pglite-socket": "^0.2.12",
    "@playwright/test": "^1.58.2",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "prisma": "6.19.3",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
