generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  OPERATOR
  VIEWER
}
enum RunStatus {
  WAITING_APPROVAL
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  REJECTED
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  passwordHash String
  role Role @default(OPERATOR)
  sessions Session[]
  workflows Workflow[]
  runs Run[]
  createdAt DateTime @default(now())
}
model Session {
  id String @id
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfToken String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model Workflow {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  owner User @relation(fields: [ownerId], references: [id])
  name String @db.VarChar(80)
  description String @db.VarChar(500)
  requiresApproval Boolean @default(true)
  maxAttempts Int @default(3)
  timeoutMs Int @default(3000)
  sandboxMode String @default("success")
  version Int @default(1)
  archived Boolean @default(false)
  runs Run[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId, archived])
}
model Run {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  owner User @relation(fields: [ownerId], references: [id])
  workflowId String @db.Uuid
  workflow Workflow @relation(fields: [workflowId], references: [id])
  workflowSnapshot Json
  idempotencyKey String @db.VarChar(100)
  requestHash String
  input Json
  output Json?
  status RunStatus
  attemptCount Int @default(0)
  cycleAttempts Int @default(0)
  recoveryCount Int @default(0)
  leaseToken String?
  leaseUntil DateTime?
  availableAt DateTime @default(now())
  errorCode String?
  errorMessage String?
  approvedBy String? @db.Uuid
  decidedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  attempts Attempt[]
  events RunEvent[]
  @@unique([ownerId, idempotencyKey])
  @@index([status, availableAt])
  @@index([ownerId, createdAt])
}
model Attempt {
  id String @id @default(uuid()) @db.Uuid
  runId String @db.Uuid
  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)
  number Int
  status String @default("STARTED")
  errorCode String?
  startedAt DateTime @default(now())
  finishedAt DateTime?
  @@unique([runId, number])
}
model RunEvent {
  id String @id @default(uuid()) @db.Uuid
  runId String @db.Uuid
  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)
  type String
  actorId String? @db.Uuid
  detail Json
  createdAt DateTime @default(now())
  @@index([runId, createdAt])
}
